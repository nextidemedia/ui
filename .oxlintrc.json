{
  "extends": ["./.nextide/oxlint.json"],
  "jsPlugins": [
    {
      "name": "hooks-js",
      "specifier": "eslint-plugin-react-hooks"
    }
  ],
  "env": {
    "browser": true
  },
  "rules": {
    "eslint/max-lines": [
      "error",
      { "max": 600, "skipBlankLines": true, "skipComments": false }
    ],
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Input"]
      }
    ]
  },
  "ignorePatterns": ["**/dist/**", "output/**"],
  "overrides": [
    {
      "files": [
        "**/tests/**",
        "**/__tests__/**",
        "**/test_*",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "rules": {
        "eslint/max-lines": [
          "error",
          { "max": 900, "skipBlankLines": true, "skipComments": false }
        ]
      }
    },
    {
      "files": ["packages/ui/**/*.{ts,tsx}", "apps/playground/**/*.{ts,tsx}"],
      "rules": {
        "eslint/for-direction": "error",
        "eslint/no-async-promise-executor": "error",
        "eslint/no-case-declarations": "error",
        "eslint/no-compare-neg-zero": "error",
        "eslint/no-cond-assign": ["error", "except-parens"],
        "eslint/no-constant-binary-expression": [
          "error",
          {
            "checkRelationalComparisons": false
          }
        ],
        "eslint/no-constant-condition": [
          "error",
          {
            "checkLoops": "allExceptWhileTrue"
          }
        ],
        "eslint/no-control-regex": "error",
        "eslint/no-debugger": "error",
        "eslint/no-delete-var": "error",
        "eslint/no-dupe-else-if": "error",
        "eslint/no-duplicate-case": "error",
        "eslint/no-empty": [
          "error",
          {
            "allowEmptyCatch": false
          }
        ],
        "eslint/no-empty-character-class": "error",
        "eslint/no-empty-pattern": [
          "error",
          {
            "allowObjectPatternsAsParameters": false
          }
        ],
        "eslint/no-empty-static-block": "error",
        "eslint/no-ex-assign": "error",
        "eslint/no-extra-boolean-cast": ["error", {}],
        "eslint/no-fallthrough": [
          "error",
          {
            "allowEmptyCase": false,
            "reportUnusedFallthroughComment": false
          }
        ],
        "eslint/no-global-assign": [
          "error",
          {
            "exceptions": []
          }
        ],
        "eslint/no-invalid-regexp": ["error", {}],
        "eslint/no-irregular-whitespace": [
          "error",
          {
            "skipComments": false,
            "skipJSXText": false,
            "skipRegExps": false,
            "skipStrings": true,
            "skipTemplates": false
          }
        ],
        "eslint/no-loss-of-precision": "error",
        "eslint/no-misleading-character-class": [
          "error",
          {
            "allowEscape": false
          }
        ],
        "eslint/no-nonoctal-decimal-escape": "error",
        "eslint/no-prototype-builtins": "error",
        "eslint/no-regex-spaces": "error",
        "eslint/no-self-assign": [
          "error",
          {
            "props": true
          }
        ],
        "eslint/no-shadow-restricted-names": [
          "error",
          {
            "reportGlobalThis": true
          }
        ],
        "eslint/no-sparse-arrays": "error",
        "eslint/no-unassigned-vars": "error",
        "eslint/no-unexpected-multiline": "error",
        "eslint/no-unsafe-finally": "error",
        "eslint/no-unsafe-optional-chaining": [
          "error",
          {
            "disallowArithmeticOperators": false
          }
        ],
        "eslint/no-unused-labels": "error",
        "eslint/no-unused-private-class-members": "error",
        "eslint/no-useless-assignment": "error",
        "eslint/no-useless-backreference": "error",
        "eslint/no-useless-catch": "error",
        "eslint/no-useless-escape": [
          "error",
          {
            "allowRegexCharacters": []
          }
        ],
        "eslint/preserve-caught-error": [
          "error",
          {
            "requireCatchParameter": false
          }
        ],
        "eslint/require-yield": "error",
        "eslint/use-isnan": [
          "error",
          {
            "enforceForIndexOf": false,
            "enforceForSwitchCase": true
          }
        ],
        "eslint/valid-typeof": [
          "error",
          {
            "requireStringLiterals": false
          }
        ],
        "eslint/no-var": "error",
        "eslint/prefer-const": [
          "error",
          {
            "destructuring": "any",
            "ignoreReadBeforeAssign": false
          }
        ],
        "eslint/prefer-rest-params": "error",
        "eslint/prefer-spread": "error",
        "typescript/ban-ts-comment": "error",
        "eslint/no-array-constructor": "error",
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-unsafe-function-type": "error",
        "eslint/no-unused-expressions": [
          "error",
          {
            "allowShortCircuit": false,
            "allowTaggedTemplates": false,
            "allowTernary": false
          }
        ],
        "eslint/no-unused-vars": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/triple-slash-reference": "error",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "warn",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/error-boundaries": "error",
        "react/purity": "off",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn",
        "hooks-js/config": "error",
        "hooks-js/gating": "error",
        "hooks-js/purity": "error"
      }
    },
    {
      "files": ["apps/playground/**/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true,
            "allowCompoundComponents": true
          }
        ]
      }
    }
  ]
}
