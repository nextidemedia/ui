{
  "name": "nextide-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "dev": "turbo dev",
    "lint": "pnpm exec oxlint --deny-warnings && turbo lint && pnpm run security:watchlist",
    "format": "prettier --write .",
    "qualify": "pnpm run test:package && pnpm --filter playground build && playwright test",
    "typecheck": "turbo typecheck",
    "security:watchlist": "node scripts/check-supply-chain.mjs",
    "test:e2e": "pnpm run build && playwright test",
    "test:package": "node scripts/check-packed-consumer.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "knip": "6.34.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.14.0"
  }
}
