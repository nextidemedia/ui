{
  "name": "nextide-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace @nextide/ui && npm run build --workspace playground",
    "check": "npm run lint && npm run typecheck && npm run build",
    "dev": "npm run build --workspace @nextide/ui && npm run dev --workspace playground",
    "lint": "vp lint --deny-warnings && npm run security:watchlist",
    "format": "prettier --write .",
    "qualify": "npm run build && e2e run",
    "typecheck": "npm run build --workspace @nextide/ui && npm run typecheck --workspaces && tsc --noEmit -p tsconfig.e2e.json",
    "security:watchlist": "node scripts/check-supply-chain.mjs",
    "test:e2e": "npm run qualify",
    "test:package": "e2e run --target package",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.99",
    "@e2e-dev/web": "0.15.2",
    "@types/node": "26.6.5",
    "ai": "7.0.148",
    "e2e": "0.21.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=26.9.0 <27",
    "npm": "12.2.1"
  },
  "workspaces": [
    "packages/ui",
    "apps/playground"
  ],
  "overrides": {
    "flatted": "3.4.4",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": true
  }
}
