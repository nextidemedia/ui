{
  "name": "nextide-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace @nextide/ui && npm run build --workspace playground",
    "check": "npm run lint && npm run typecheck && npm run build",
    "dev": "npm run build --workspace @nextide/ui && npm run dev --workspace playground",
    "lint": "vp lint --deny-warnings && npm run security:watchlist",
    "format": "prettier --write .",
    "qualify": "npm run build && e2e run",
    "typecheck": "npm run build --workspace @nextide/ui && npm run typecheck --workspaces && tsc --noEmit -p tsconfig.e2e.json",
    "security:watchlist": "node scripts/check-supply-chain.mjs",
    "test:e2e": "npm run qualify",
    "test:package": "e2e run --target package",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.16.1",
    "@types/node": "^26.6.6",
    "e2e": "^0.24.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": "^26.0.0",
    "npm": ">=12"
  },
  "workspaces": [
    "packages/ui",
    "apps/playground"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^8.0.0"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild": true
  }
}
